{
    "name": "libjpeg",
    "description": "JPG encoder and decoder",
    "filters":["rfjpeg","jpegdec","encjpg"],
    "help": "This filter encodes and decodes to JPEG using libjpeg.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libjpeg.accessor",
    "filter_source":{
        "rfjpeg" : "reframe_jpeg.c",
        "jpegdec" : "dec_jpeg.c",
        "encjpg" : "enc_jpg.c"
    },
    "Format": ["JPEG"],
    "using": ["solver_minimal_1"],
    "runtime": {
        "jpegdec": {
            "outputs": [
                {
                    "property": "GF_PROP_PID_PIXFMT",
                    "format": [
                        "GF_PIXEL_RGB"
                    ]
                }
            ]
        }
    },
    "patents": {
        "status": "expired",
        "note": "JPEG baseline",
        "checked": "2026-10-16"
    }
}
